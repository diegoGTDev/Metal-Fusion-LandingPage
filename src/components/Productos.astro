---
import Card from "./Card.astro"

const productos = [
    {
        title: "Acero Estructural",
        description: "Vigas IPN, UPN, perfiles y tubos de acero de alta resistencia para el armado de estructuras sólidas y seguras.",
        imageUrl: "/images/herramientas-electricas.webp"
    },
    {
        title: "Varillas y Mallas",
        description: "Acero corrugado y mallas electrosoldadas de las mejores marcas para refuerzo de concreto en grandes obras.",
        imageUrl: "/images/materiales-construccion.webp"
    },
    {
        title: "Láminas y Cubiertas",
        description: "Láminas acanaladas, lisas y galvanizadas ideales para techos, cerramientos y revestimientos industriales.",
        imageUrl: "/images/herramientas-de-mano.webp"
    },
    {
        title: "Accesorios y Fijaciones",
        description: "Alambres de amarre, clavos, tornillos de alta resistencia y elementos de fijación para la construcción.",
        imageUrl: "/images/pintura-y-suministros.webp"
    }
]
---

<section id="productos" class="bg-[#EFEFEF] flex flex-col lg:flex-row min-h-screen ">
  <!-- Texto e informacion -->
  <div class="flex flex-col items-center justify-center lg:w-1/3 w-full lg:p-10 p-4 ">
    <h2 class="lg:text-6xl text-5xl text-center lg:text-justify font-bold mb-4 text-[#CC0000]">Nuestros Productos</h2>
    <p class="lg:text-lg text-sm text-justify text-gray-600 mb-8">
      Explora nuestra selección de acero, perfiles, mallas e insumos metalúrgicos
      de alta resistencia para todas tus obras.
    </p>
  </div>
  <!-- Imagenes de los productos -->
  <div class="flex lg:flex-row flex-col lg:items-stretch lg:justify-evenly items-stretch justify-evenly lg:h-screen lg:w-fit w-full h-fit  lg:overflow-auto">
  <!-- Aca iran las cards -->
   {productos.map(card => (
     <Card title={card.title} description={card.description} imageUrl={card.imageUrl} />
   ))}
  </div>
</section>
