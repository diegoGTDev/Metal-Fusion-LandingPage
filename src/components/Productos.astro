---
import Card from "./Card.astro";

const productos = [
  {
    title: "Tuberia",
    description:
      "Tuberias de PVC y metálicas, de la mejor calidad para todas tus necesidades.",
    imageUrl: "/images/tuberia.webp",
  },
  {
    title: "Varillas",
    description:
      "Varillas de acero de la mejor calidad para todas tus necesidades.",
    imageUrl: "/images/materiales-construccion.webp",
  },
  {
    title: "Láminas y Cubiertas",
    description:
      "Láminas acanaladas, lisas y galvanizadas ideales para techos, cerramientos y revestimientos industriales.",
    imageUrl: "/images/lamina.webp",
  },
  {
    title: "Productos de construcción",
    description:
      "Alambres de amarre, clavos, tornillos de alta resistencia y elementos de fijación para la construcción.",
    imageUrl: "/images/cemento.webp",
  },
];
---

<section
  id="productos"
  class="bg-[#EFEFEF] flex flex-col lg:flex-row min-h-screen overflow-hidden relative"
>
  <!-- Texto e informacion -->
  <div
    class="flex flex-col items-center justify-center lg:w-1/3 w-full lg:p-10 p-4"
  >
    <h2
      class="lg:text-6xl text-5xl text-center lg:text-justify font-bold mb-4 text-[#CC0000]"
    >
      Nuestros Productos
    </h2>
    <p class="lg:text-lg text-sm text-justify text-gray-600 mb-8">
      Explora nuestra selección de material de construcción, tuberias, perfiles
      y laminas de alta resistencia para todas tus obras.
    </p>
  </div>
  <!-- Imagenes de los productos -->
  <div
    class="flex lg:flex-row flex-col lg:items-stretch lg:justify-evenly items-stretch justify-evenly lg:h-screen lg:w-2/3 w-full h-fit lg:overflow-hidden"
  >
    <!-- Aca iran las cards -->
    {
      productos.map((card) => (
        <Card
          title={card.title}
          description={card.description}
          imageUrl={card.imageUrl}
        />
      ))
    }
  </div>
</section>
