---
import CatalogCard from './CatalogCard.astro';

type Spec = {
	espesor?: string;
	medidas?: string[] | string;
	descripcionCorta?: string;
};

type CatalogItem = {
	title: string;
	imageUrl?: string;
	description?: string;
	specs?: Spec;
};

const { id, title, items } = Astro.props as {
	id?: string;
	title: string;
	items?: CatalogItem[];
};
---

<section id={id} class="py-8 md:py-12 scroll-mt-24 md:scroll-mt-32">
	<div class="max-w-6xl mx-auto px-4">
		<div class="flex items-center justify-between mb-6">
			<h2 class="text-2xl md:text-3xl font-bold text-[#292929]">{title}</h2>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch auto-rows-[1fr]">
			{items && items.map((item: CatalogItem) => (
				<CatalogCard
					title={item.title}
					imageUrl={item.imageUrl}
					description={item.description}
					specs={item.specs}
				/>
			))}
		</div>
	</div>
</section>
