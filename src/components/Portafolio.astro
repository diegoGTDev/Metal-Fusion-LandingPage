---
import PortafolioCard from "./cards/PortafolioCard.astro";
const trabajos = [
  {
    title: "Establo para ganadería",
    description:
      "Estructura metálica para establo para ganadería. Cuenta con los mejores materiales y acabados de alta calidad para garantizar la seguridad y comodidad de los animales.",
    imageUrl: "/images/portafolio-1.webp",
  },
  {
    title: "Potrero",
    description:
      "Estructura metálica de alta calidad diseñada para el resguardo de ganado. Fabricada con materiales duraderos que garantizan resistencia, funcionalidad y una larga vida útil.",
    imageUrl: "/images/portafolio-2.webp",
  },
];
---

<section
  id="portafolio"
  class="bg-white px-4 md:px-8 text-center min-h-screen py-16 lg:py-24 flex items-center justify-center"
>
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-[#C00000] mb-4">
      El fruto de nuestros productos
    </h2>
    <h3 class="text-lg md:text-xl lg:text-2xl text-[#454444] mb-16">
      Proyectos con la calidad que nos caracteriza
    </h3>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 justify-items-stretch">
      {
        trabajos.map((trabajo) => (
          <PortafolioCard
            title={trabajo.title}
            description={trabajo.description}
            imageUrl={trabajo.imageUrl}
          />
        ))
      }
    </div>
  </div>
</section>
