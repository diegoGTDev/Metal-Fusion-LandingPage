---
interface Props {
  title: string;
  description: string;
  imageUrl: string;
}

const { title, description, imageUrl } = Astro.props;
---

<div
  class="group relative flex flex-col overflow-hidden rounded-2xl bg-white shadow-lg transition-all duration-300 hover:shadow-2xl hover:-translate-y-2 border border-gray-100 h-full"
>
  <div class="relative h-64 overflow-hidden">
    <div
      class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10"
    >
    </div>
    <img
      class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-110"
      src={imageUrl}
      alt={title}
    />
  </div>

  <div class="flex flex-col flex-1 p-6 md:p-8 relative">
    <h3
      class="text-2xl font-extrabold text-gray-900 mb-3 group-hover:text-red-600 transition-colors duration-300"
    >
      {title}
    </h3>

    <p class="text-gray-600 mb-6 flex-1 leading-relaxed">
      {description}
    </p>
  </div>
</div>
