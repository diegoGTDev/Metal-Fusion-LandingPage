---
interface props {
  title: string;
  description: string;
  imageUrl: string;
}
const { title, description, imageUrl } = Astro.props;
---

<div
  data-card
  class="group w-full h-50 lg:h-full lg:w-1/4 lg:hover:w-[45%] transition-all duration-500 ease-in-out shadow-xl relative min-h-full lg:-skew-x-[15deg] cursor-pointer hover:z-30 overflow-hidden"
>
  <!-- Aca ira la imagen -->
  <div
    class="absolute inset-0 lg:-left-[50%] lg:-right-[50%] lg:skew-x-[15deg]"
  >
    <img
      src={Astro.props.imageUrl}
      class="w-full h-full object-cover transition-transform duration-700 ease-in-out group-hover:scale-110"
    />
  </div>
  <!-- Aca se mostrara la info del card -->
  <div
    id="info"
    class="text-center p-5 absolute inset-0 z-20 flex items-center justify-center lg:opacity-0 transition-all duration-500 ease-in-out group-hover:opacity-100 lg:group-hover:bg-black/60 bg-black/60 group-[.is-visible]:opacity-100 group-[.is-visible]:bg-black/60"
    class="text-center p-5 absolute inset-0 z-20 flex items-center justify-center lg:opacity-0 transition-all duration-500 ease-in-out group-hover:opacity-100 lg:group-hover:bg-black/60 bg-black/60 group-[.is-visible]:opacity-100 group-[.is-visible]:bg-black/60"
  >
    <div
      class="flex flex-col items-center justify-center text-white px-6 w-[280px] lg:skew-x-[15deg] opacity-0 translate-y-4 transition-all duration-500 delay-100 ease-out group-hover:opacity-100 group-hover:translate-y-0 group-[.is-visible]:opacity-100 group-[.is-visible]:translate-y-0"
    >
      <h3 class="font-bold text-2xl drop-shadow-lg text-balance">
        {Astro.props.title}
      </h3>
      <p
        class="text-sm font-medium mt-4 drop-shadow-md leading-relaxed text-pretty"
      >
        {Astro.props.description}
      </p>
    </div>
  </div>
</div>

<script>
  const cards = document.querySelectorAll("[data-card]");

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
          console.log("es visible");
        } else {
          // Opcional: remover la clase al salir del viewport
          entry.target.classList.remove("is-visible");
        }
      });
    },
    {
      threshold: 0.4, // La card debe estar 40% visible para activarse
    },
  );

  cards.forEach((card) => observer.observe(card));
</script>

