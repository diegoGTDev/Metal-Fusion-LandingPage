---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/MetalFusionFavicon.svg" />
    <meta
      name="keywords"
      content="Metal, Fusion, Perfiles, Herramientas, Guatemala, Maquinas"
    />
    <meta
      name="description"
      content="Metal Fusion es tu proveedor de insumos metalúrgicos en Guatemala. Ofrecemos acero, perfiles, mallas y asesoría experta para llevar las obras de tu constructora al siguiente nivel. Calidad, confianza y servicio personalizado."
    />
    <meta property="og:title" content="Metal Fusion" />
    <meta
      property="og:description"
      content="Conoce a tu futuro aliado en tu proyecto, Metal Fusion."
    />
    <meta
      property="og:image"
      content="https://metal-fusion-gt.com/images/Logo.jpg"
    />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="300" />
    <meta property="og:url" content="https://metal-fusion-gt.com" />
    <meta property="og:type" content="website" />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="metal-fusion-gt.com" />
    <meta property="twitter:url" content="https://metal-fusion-gt.com" />
    <meta name="twitter:title" content="Metal Fusion" />
    <meta
      name="twitter:description"
      content="Conoce a tu futuro aliado en tu proyecto, Metal Fusion."
    />
    <meta
      name="twitter:image"
      content="https://metal-fusion-gt.com/images/Logo.jpg"
    />

    <meta name="robots" content="index, follow" />

    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="canonical" href="https://metal-fusion-gt.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <meta name="color-scheme" content="dark" />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap"
      rel="stylesheet"
    />
    <title>Metal Fusion - Fuerza y calidad en cada pieza</title>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "HardwareStore",
        "name": "Metal Fusion",
        "image": "https://metal-fusion-gt.com/images/Logo.jpg",
        "url": "https://metal-fusion-gt.com",
        "telephone": "+502 5777-4270",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "4ta Calle 6ta Avenida 5-75 Zona 1",
          "addressLocality": "Escuintla",
          "addressRegion": "Guatemala",
          "postalCode": "07001",
          "addressCountry": "GT"
        },
        "description": "Proveedor de insumos metalúrgicos en Guatemala Escuintla. Acero, perfiles estructurales, mallas y asesoría experta para constructoras y proyectos."
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
